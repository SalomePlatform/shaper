<workbench id="Macros" document="Part">
    <group id="Custom">

      <feature id="SplitCylinder"
               title="Split Cylinder"
               tooltip="Split a cylinder into quadrants with a central square core"
               icon="icons/Addons/splitCylinder.png">

        <shape_selector
            id="solid_body"
            label="Solid body"
            tooltip="Select the cylinder's solid body"
            shape_types="solid">
        </shape_selector>

        <shape_selector
            id="face"
            label="Cylinder face"
            tooltip="Select the flat circular face"
            shape_types="face">
        </shape_selector>

        <boolvalue 
            id="is_percentage" 
            label="Value is percentage (%)" 
            default="false" 
            tooltip="Check to use percentage of diameter">
        </boolvalue>

        <doublevalue
            id="size_input"
            label="Value"
            default="4."
            step="1.">
        </doublevalue>

      </feature>
    </group>
  </workbench>